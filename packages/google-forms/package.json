{
  "$schema": "https://assets.xentom.com/schemas/package.json",
  "name": "@xentom/google-forms",
  "version": "0.1.0",
  "displayName": "Google Forms",
  "description": "Integration for Google Forms to create forms, retrieve responses, and manage form data in workflows.",
  "categories": [
    "Productivity"
  ],
  "homepage": "https://xentom.com/integrations/xentom/google-forms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xentom/integrations.git",
    "directory": "packages/google-forms"
  },
  "bugs": {
    "url": "https://github.com/xentom/integrations/issues"
  },
  "type": "module",
  "icon": "./assets/icon.webp",
  "main": "./build/index.js",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo node_modules build dist",
    "dev": "xentom dev",
    "build": "xentom build",
    "pack": "xentom pack",
    "publish": "xentom publish"
  },
  "dependencies": {
    "@xentom/integration-framework": "catalog:",
    "google-auth-library": "10.5.0",
    "googleapis": "catalog:",
    "valibot": "catalog:"
  }
}
